Origin: commit da9b0f3a3d56a2e60490fa5f23ca510862c252cd from https://github.com/alire-project/dak_simple_components.git
Properties:
   Author: Dmitry A. Kazakov
   Description: Simple Components - A collection of support packages
   GPR Scenario: Development := Debug | Release | Profile
   GPR Scenario: Driver := MySQL | PostgreSQL | SyBase | CT_Lib
   GPR Scenario: Legacy := Ada95 | Ada2005 | Ada2012
   GPR Scenario: Target_OS := Windows | Windows_NT | Linux | UNIX | OSX | FreeBSD | auto
   GPR Scenario: Tasking := Multiple | Single
   GPR Scenario: Traced_Objects := Off | On
   case OS is
      when Freebsd => GPR External: Target_OS := FreeBSD
      when Linux => (GPR External: Target_OS := Linux and GPR External: odbc := unixODBC)
      when Macos => GPR External: Target_OS := OSX
      when Windows => (GPR External: Target_OS := Windows and GPR External: odbc := ODBC32)
   case Word_Size is
      when Bits_32 => GPR External: arch := i686
      when Bits_64 => GPR External: arch := x86_64
