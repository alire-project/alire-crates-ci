   Author: AdaCore
   Configuration: no modifiers
   Description: A simple library to spawn processes and communicate with them.
   GPR Scenario: SPAWN_OS := unix | osx | Windows_NT
   case OS is
      when Linux => GPR External: SPAWN_OS := unix
      when Macos => GPR External: SPAWN_OS := osx
      when Windows => GPR External: SPAWN_OS := Windows_NT
   License: Apache-2.0 WITH LLVM-exception
