   Author: Gautier de Montmollin
   Description: GLOBE_3D: GL Object Based Engine for 3D
   Executable: globe_3d_demo
   Executable: mini_3d
   GPR Scenario: G3D_Build_Mode := debug | fast | small
   GPR External: GID_Build_Mode := Debug
