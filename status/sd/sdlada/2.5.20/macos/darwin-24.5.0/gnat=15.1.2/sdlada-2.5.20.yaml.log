Origin: commit cd53c280e95697ad7f1b2151f1bad68742a0e7b8 from https://github.com/Lucretia/sdlada.git
Properties:
   Pre_Build run: make -C ./build/gnat tools (from ${CRATE_ROOT}/.)
   Author: Luke A. Guest
   Description: Ada 2012 SDL 2.x bindings.
   case Distribution is
      when Msys2 => Environment: C_INCLUDE_PATH=${C_INCLUDE_PATH}:${DISTRIB_ROOT}/mingw64/include/SDL2
   GPR Scenario: SDL_MODE := debug | release
   GPR Scenario: SDL_PLATFORM := linux | bsd | windows | macosx | macos_homebrew | macos_ports | ios | android
   case OS is
      when Linux => GPR External: SDL_PLATFORM := linux
      when Macos => GPR External: SDL_PLATFORM := macosx
      when Windows => GPR External: SDL_PLATFORM := windows
   License: Zlib
