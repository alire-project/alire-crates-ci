   Description: A high level Unicode text processing library
   case OS is
      when Linux => Environment: LD_LIBRARY_PATH=${LD_LIBRARY_PATH}:${CRATE_ROOT}/.libs/release/relocatable
      when Macos => Environment: DYLD_LIBRARY_PATH=${DYLD_LIBRARY_PATH}:${CRATE_ROOT}/.libs/release/relocatable
      when Windows => Environment: PATH=${PATH}:${CRATE_ROOT}/.libs/release/relocatable
   GPR Scenario: VSS_LIBRARY_TYPE := relocatable | static | static-pic
